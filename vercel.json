{
  "buildCommand": "npm run build:site",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    { "source": "/strudelify", "destination": "/index.html" },
    { "source": "/strudelify/", "destination": "/index.html" },
    { "source": "/strudelify/:path+/", "destination": "/:path+" },
    { "source": "/strudelify/:path+", "destination": "/:path+" }
  ]
}
